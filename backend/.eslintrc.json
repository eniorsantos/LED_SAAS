{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": [
    "eslint:recommended",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "commonjs"
  },
  "plugins": [
    "prettier"
  ],
  "rules": {
    "prettier/prettier": "error",
    "no-unused-vars": "warn",
    "no-console": "off",
    "eqeqeq": ["error", "always"],
    "no-undef": "error",
    "no-unreachable": "error",
    "no-duplicate-case": "error"
  },
  "ignorePatterns": ["node_modules/", "dist/", "data.db", "*.db-*", ".env"]
}
