# Porta da API
PORT=3001

# Segredo do JWT (obrigatório em produção; troque o padrão)
JWT_SECRET=led-control-dev-mude-em-producao

# "Hoje" lógico (data real se vazio). Use para simular/testar: 2026-10-25
HOJE=

# Popula dataset demo no primeiro boot (somente dev/homolog)
SEED=

# Caminho do SQLite. No Render com disco persistente use /data/data.db
DB_PATH=./data.db

# Se quiser usar Supabase/PostgreSQL em vez do SQLite, defina DATABASE_URL
# e use o adaptador backend/src/db.supabase.js (ver supabase/schema.sql)
DATABASE_URL=
